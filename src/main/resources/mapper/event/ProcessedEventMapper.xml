<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.github.hgdcoder.flowershow.persistence.mapper.event.ProcessedEventMapper">

    <select id="countProcessed" resultType="_int">
        select count(*)
        from consumer_processed_events
        where consumer_name = #{consumerName}
          and event_id = #{eventId}
    </select>

    <insert id="insertProcessed">
        insert into consumer_processed_events (consumer_name, event_id)
        values (#{consumerName}, #{eventId})
    </insert>
</mapper>
