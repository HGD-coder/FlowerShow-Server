# Copy this file to .env only after creating a named Cloudflare Tunnel.
# In the Cloudflare dashboard, route the public hostname to http://nginx:8088.
FLOWER_SHOW_PUBLIC_GATEWAY_BASE_URL=https://api.example.com
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: bootstrap the first admin account (role=admin) on startup.
# Required to use the ADMIN-only endpoints /api/v1/accounts and /api/v1/import.
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_PASSWORD=change-me-to-a-long-random-password
